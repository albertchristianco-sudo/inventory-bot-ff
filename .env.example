# Notion
NOTION_API_KEY=your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id
NOTION_SALES_DB_ID=your_sales_database_id

# Notion — FF Sales Log (daily report processing)
FF_SALES_LOG_DB_ID=a3406a84-4be0-41d0-9593-8090cae4133c

# Notion — FF Sales Archive (where Sunday cron moves Processed sales each week).
# Create this database in Notion with the SAME schema as FF Sales Log
# (easiest: duplicate FF Sales Log → empty the rows → share with the Notion
# integration → grab the new database ID from the URL and paste it here).
FF_SALES_ARCHIVE_DB_ID=

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Telegram — bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram — owner's private chat with the bot. The 6PM daily report and any
# mismatch clarification alerts are sent here. For a private DM, this value
# equals the owner's Telegram user ID.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram — owner's numeric user ID. This is the ONLY ID allowed to chat with
# the bot. Defaults to TELEGRAM_CHAT_ID (correct for a private DM). Only set
# this explicitly if TELEGRAM_CHAT_ID is a group ID and you want the bot to
# DM-respond to one person.
OWNER_TELEGRAM_ID=

# Telegram — optional shared secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header. Set to any random string to block forged webhook calls.
TELEGRAM_WEBHOOK_SECRET=

# Hermes — shared secret on POST /run-daily-report. Hermes (external cron agent)
# sends this in the X-Hermes-Secret header at 18:00 Mon-Sat Asia/Manila to trigger
# the daily report. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset to disable the check (e.g. for local development).
HERMES_SECRET=
