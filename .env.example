# Notion
NOTION_API_KEY=your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id
NOTION_SALES_DB_ID=your_sales_database_id

# Notion — FF Sales Log (daily report processing)
FF_SALES_LOG_DB_ID=a3406a84-4be0-41d0-9593-8090cae4133c

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Telegram — bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram — chat ID where the 6PM daily report is sent (owner's private chat, or a group ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram — owner's chat ID for mismatch clarification alerts (defaults to TELEGRAM_CHAT_ID if unset)
TELEGRAM_OWNER_CHAT_ID=

# Telegram — optional shared secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header. Set to any random string to block forged webhook calls.
TELEGRAM_WEBHOOK_SECRET=

# App — comma-separated numeric Telegram user IDs allowed to chat with the bot.
# Each staff member messages @userinfobot on Telegram to get their user ID.
ALLOWED_TELEGRAM_IDS=123456789,987654321
